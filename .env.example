# # =============================================================================
# # MSNSS – M S HVAC Engineers · Environment Variables
# # Copy to .env (local) or set in your host dashboard (Hostinger / Render).
# # Never commit real secrets. Variables marked SERVER ONLY must never be exposed
# # to the browser and must NOT be prefixed with NEXT_PUBLIC_.
# # =============================================================================

# # --- Database (SERVER ONLY, REQUIRED) ---------------------------------------
# # PostgreSQL / Supabase connection string used by Drizzle ORM.
# # Supabase: Project Settings → Database → Connection string.
# # Use the pooler URI for serverless; append ?sslmode=require if needed.
# # Example: postgresql://user:password@host:5432/postgres?sslmode=require
# DATABASE_URL=

# # --- Admin auth secret (SERVER ONLY, REQUIRED IN PRODUCTION) ----------------
# # Signs admin JWT session cookies. Must be a long random string (>= 32 chars).
# # Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# # The app will REFUSE to start admin auth in production if this is missing.
# AUTH_SECRET=

# # --- Public site URL (CLIENT + SERVER, REQUIRED) ----------------------------
# # Canonical production URL. Used for canonical tags, sitemap, OG URLs and the
# # "view inquiry" link inside owner emails. No trailing slash.
# # Example: https://www.msnss.com
# NEXT_PUBLIC_SITE_URL=

# # --- Resend email (SERVER ONLY, REQUIRED for email notifications) -----------
# # Get a restricted API key at https://resend.com after verifying your domain.
# # If unset, inquiries are still SAVED but no email is sent (fail-safe).
# RESEND_API_KEY=
# # Verified sender. Example: "MSNSS <sales@msnss.com>"
# MAIL_FROM=
# # Where new-inquiry notifications are delivered. Example: sales@msnss.com
# OWNER_EMAIL=

# # --- Supabase Storage (SERVER ONLY service role; RECOMMENDED for production) -
# # Required for reliable media on Render (ephemeral filesystem) and recommended
# # on Hostinger. If unset, the app falls back to local disk uploads (dev only).
# # Supabase: Project Settings → API.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# # SERVER ONLY — full storage admin rights. NEVER expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.oamglnejmhrurgqdkvlw:MSNSS%25!%40%23_H@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
AUTH_SECRET=f1177edd5ccf13bc6d00dce60b8d8972ee6ad5d04e2ed0721978d31e5c480741bc0f5f8058fe028de62db678bfd2ce0e
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

RESEND_API_KEY=
MAIL_FROM=
OWNER_EMAIL=

NEXT_PUBLIC_SUPABASE_URL=https://oamglnejmhrurgqdkvlw.supabase.co
